# NOVA SALUD PRO - CONFIGURACION DE EJEMPLO
# Copiar este archivo como .env
# Nunca subir credenciales reales a GitHub

# Servidor
NOVA_HOST=0.0.0.0
PORT=3001

# Seguridad administrativa
NOVA_ADMIN_PASSWORD=CAMBIA_POR_UNA_CONTRASENA_LARGA_Y_PRIVADA
COOKIE_SECURE=false

# Inteligencia artificial
AI_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Compatibilidad con configuraciones anteriores
NOVA_AI_MODEL=gpt-4o-mini

# Base de datos
NOVA_STORAGE=mysql

# XAMPP local
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=nova_salud

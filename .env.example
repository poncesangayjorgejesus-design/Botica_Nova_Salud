# COPIA COMO .env, NO SUBIR A GITHUB
NOVA_HOST=0.0.0.0
PORT=3000
NOVA_ADMIN_PASSWORD=CAMBIA_POR_UNA_CONTRASENA_LARGA_Y_PRIVADA
OPENAI_API_KEY=
NOVA_AI_MODEL=gpt-4o-mini
COOKIE_SECURE=false

# XAMPP MySQL (modo principal para la exposición académica)
NOVA_STORAGE=mysql
# Si ejecutas Node.js directamente en Windows usa 127.0.0.1
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
# En XAMPP local usualmente root no tiene clave; se recomienda configurar usuario/clave propios.
MYSQL_PASSWORD=
MYSQL_DATABASE=nova_salud
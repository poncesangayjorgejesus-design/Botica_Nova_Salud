
# ============================================
# NOVA SALUD PRO - CONFIGURACION DE EJEMPLO
# ============================================
# Copiar a .env para configurar el entorno local.
# Nunca subir el archivo .env a GitHub.

# ============================================
# SERVIDOR
# ============================================

NOVA_HOST=0.0.0.0
PORT=3000

# ============================================
# ADMINISTRACION - SISTEMA PRINCIPAL
# ============================================

NOVA_ADMIN_PASSWORD=CAMBIAR_POR_CONTRASENA_PRIVADA_SEGURA
COOKIE_SECURE=false

# ============================================
# SEGURIDAD - API DE PRODUCTOS
# ============================================

# Clave privada de al menos 32 caracteres.
# Utilizada por el middleware de demostracion.
ADMIN_API_KEY=

# ============================================
# INTELIGENCIA ARTIFICIAL
# ============================================

OPENAI_API_KEY=

# Configuracion del sistema principal
NOVA_AI_MODEL=gpt-4o-mini

# Configuracion de nuestro modulo backend
AI_ENABLED=false
OPENAI_MODEL=gpt-4o-mini

# ============================================
# MYSQL - XAMPP
# ============================================

NOVA_STORAGE=mysql

# Para Node.js ejecutado directamente en Windows
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=nova_salud

# ============================================
# FIN DE CONFIGURACION
# ============================================

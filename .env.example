# ============================================
# NOVA SALUD PRO - CONFIGURACION DE EJEMPLO
# ============================================
# Copiar este archivo como .env
# Nunca subir credenciales reales a GitHub.

# SERVIDOR
NOVA_HOST=0.0.0.0
PORT=3001

# ADMINISTRACION
NOVA_ADMIN_PASSWORD=CAMBIAR_POR_CONTRASENA_PRIVADA_SEGURA
COOKIE_SECURE=false

# SEGURIDAD DE API
ADMIN_API_KEY=

# INTELIGENCIA ARTIFICIAL
AI_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
NOVA_AI_MODEL=gpt-4o-mini

# BASE DE DATOS MYSQL - XAMPP
NOVA_STORAGE=mysql
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=nova_salud

# FIN DE CONFIGURACION
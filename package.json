{
  "name": "nova-salud-pro",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --watch server/index.js",
    "dev:client": "vite --config client/vite.config.js --host 127.0.0.1",
    "build": "vite build --config client/vite.config.js",
    "start": "node server/index.js",
    "test": "node --test tests/*.test.js",
    "db:check": "node --env-file=.env scripts/check-mysql.mjs",
    "db:seed": "node --env-file=.env scripts/import_mysql.mjs",
    "test:ui": "node tests/ui-smoke.mjs"
  },
  "dependencies": {
    "dotenv": "^18.0.9",
    "express": "^4.21.2",
    "lucide-react": "^0.468.0",
    "mysql2": "^3.14.0",
    "openai": "^7.50.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "vite": "^5.4.11"
  }
}
